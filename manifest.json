{
  "manifest_version": 3,
  "name": "AI Screenshot Attacher",
  "short_name": "AI Attacher",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "description": "Attach clipboard screenshots to ChatGPT, Claude, Gemini, or Doubao after your action. It never sends messages automatically.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup/popup.html",
    "default_title": "AI Screenshot Attacher"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage", "clipboardRead", "clipboardWrite", "offscreen"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://doubao.com/*",
    "https://www.doubao.com/*"
  ],
  "commands": {
    "attach-to-default-ai": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Attach clipboard screenshot to the default AI target"
    },
    "attach-to-chatgpt": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Attach clipboard screenshot to ChatGPT"
    },
    "attach-to-claude": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Attach clipboard screenshot to Claude"
    },
    "attach-to-gemini": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Attach clipboard screenshot to Gemini"
    },
    "attach-to-doubao": {
      "description": "Attach clipboard screenshot to Doubao"
    }
  }
}
