{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.2.0",
  "default_locale": "en",
  "minimum_chrome_version": "109",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage", "clipboardRead", "clipboardWrite", "offscreen"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://doubao.com/*",
    "https://www.doubao.com/*",
    "https://grok.com/*"
  ],
  "commands": {
    "attach-to-default-ai": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_commandAttachDefault__"
    },
    "attach-to-chatgpt": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "__MSG_commandAttachChatgpt__"
    },
    "attach-to-claude": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "__MSG_commandAttachClaude__"
    },
    "attach-to-gemini": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "__MSG_commandAttachGemini__"
    },
    "attach-to-doubao": {
      "description": "__MSG_commandAttachDoubao__"
    },
    "attach-to-grok": {
      "description": "__MSG_commandAttachGrok__"
    }
  }
}
